# ============================================================
# SR ENTERPRISES CRM — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
# Target Architecture:
# - Frontend: Web SPA / PWA
# - Backend API: Fastify + TypeScript (Oracle Cloud Infrastructure / VM / Docker)
# - Database: PostgreSQL
# - Object Storage: Local Persistent Filesystem Storage
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------
# Public base URL of the Backend API (e.g. https://api.yourdomain.com)
VITE_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------
# 2. BACKEND SERVER
# ------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Public API URL for self-referencing callbacks and health audits
API_URL=https://api.yourdomain.com
# Frontend Domain (used for CORS allowlist)
WEB_URL=https://crm.yourdomain.com
# Additional comma-separated origins for CORS if using custom domains
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
LOG_LEVEL=info

# ------------------------------------------------------------
# 3. POSTGRESQL DATABASE
# ------------------------------------------------------------
# Standard PostgreSQL Connection String: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=[require|disable]
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@localhost:5432/sr_enterprises_crm
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Optional Secondary Archive PostgreSQL Database (for historical archives)
# ARCHIVE_DATABASE_URL=postgresql://postgres:your_archive_db_password@archive-host:5432/sr_enterprises_crm_archive

# ------------------------------------------------------------
# 4. CACHE & BACKGROUND JOBS (REDIS)
# ------------------------------------------------------------
# Optional: If Redis is absent, the backend automatically uses its high-performance in-memory fallback
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------
# High-entropy 32+ character secrets
COOKIE_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
SESSION_SECRET=replace_with_another_secure_random_string_of_32_characters
JWT_SECRET=replace_with_a_third_secure_random_string_of_32_characters_here
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL / SMTP (PHPMailer & Nodemailer)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=varpes380@gmail.com
SMTP_PASS=tiyx kkmy cwvt vowo
SMTP_FROM_EMAIL=varpes380@gmail.com
SMTP_FROM_NAME=Revamp
SUPPORT_EMAIL=varpes380@gmail.com
SUPPORT_PHONE=+91 9021653893
MOCK_MAIL=false

# ------------------------------------------------------------
# 7. WHATSAPP & EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=sr_enterprises_wa_verify_token

