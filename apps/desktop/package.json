{
  "name": "@crm/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprises CRM - Local Desktop Application",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron .",
