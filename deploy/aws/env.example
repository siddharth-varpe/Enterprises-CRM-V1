# ==============================================================================
# ENTERPRISES CRM — AWS EC2 PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Target: /etc/enterprises-crm.env (chmod 600, owned by root:crmapp)
# Security: NEVER commit real production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
# Fastify binds to loopback interface on EC2 behind Nginx reverse proxy
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Production URLs (replace crm.example.com with your registered production domain)
API_URL=https://crm.example.com
WEB_URL=https://crm.example.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL - Internal Loopback)
# ------------------------------------------------------------------------------
# Standard format: postgresql://[user]:[password]@127.0.0.1:5432/[dbname]
# Note: PostgreSQL must be bound to localhost only (never exposed publicly)
DATABASE_URL=postgresql://crm_user:REPLACE_WITH_STRONG_RANDOM_PASSWORD@127.0.0.1:5432/enterprises_crm

# Database Pool Settings for EC2 Single-Instance (t3.medium / t3.large)
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000

# Optional isolated PostgreSQL database for historical archive data (leave blank if unused)
# ARCHIVE_DATABASE_URL=postgresql://archive_user:PASSWORD@127.0.0.1:5432/enterprises_crm_archive

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Temporary Geolocation, Session & Rate Limiting)
# ------------------------------------------------------------------------------
# Internal Loopback Redis (never exposed publicly)
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE SECRETS (CRITICAL: Generate with 'openssl rand -hex 32')
# ------------------------------------------------------------------------------
# At least 32 characters random strings
COOKIE_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS

# Session Lifetime and Security Policies
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_SAME_SITE=lax

# Production CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://crm.example.com

# ------------------------------------------------------------------------------
# 5. GOOGLE MAPS PLATFORM (Technician Live Tracking & Navigation)
# ------------------------------------------------------------------------------
# Maps JavaScript API Key (Used by Admin Live Map & Technician Portal)
MAPS_JAVASCRIPT_API_KEY=AIzaSy_YOUR_BROWSER_KEY_HERE
GOOGLE_MAPS_BROWSER_API_KEY=AIzaSy_YOUR_BROWSER_KEY_HERE

# Routes API & Geocoding Key (Server-side routing & ETA computation)
ROUTES_API_KEY=AIzaSy_YOUR_SERVER_KEY_HERE
GOOGLE_MAPS_SERVER_API_KEY=AIzaSy_YOUR_SERVER_KEY_HERE

# Advanced Vector Map ID (Created in Google Cloud Console Maps Management)
MAP_ID=YOUR_GOOGLE_MAP_ID_HERE
GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAP_ID_HERE

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL / NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
# Used for Technician OTP verification and CRM customer alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Enterprises CRM"

SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE="+91 98765 43210"

# Mail driver mode: 'smtp' for production, or 'mock' for local sandbox testing
MAIL_DRIVER=smtp

# ------------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS CLOUD API (Optional - Customer Notifications)
# ------------------------------------------------------------------------------
# Note: Technician work orders are delivered directly via Portal, not WhatsApp
WHATSAPP_PROVIDER=META
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=enterprises_crm_wa_verify_token
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 8. LOCAL STORAGE & BACKUP PATHS
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_PATH=/var/lib/enterprises-crm/storage/documents
BACKUP_DIR=/var/backups/enterprises-crm
